{
  "name": "lol-esports-backend",
  "version": "0.1.0",
  "description": "Backend for LoL E-Sports Team Explorer",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc && npm run copy:prompts",
    "copy:prompts": "mkdir -p dist/prompts/personas && cp src/prompts/*.md dist/prompts/ && cp src/prompts/personas/*.md dist/prompts/personas/",
    "start": "node dist/main.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/cors": "^2.8.17",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0"
  }
}
