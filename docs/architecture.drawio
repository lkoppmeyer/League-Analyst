          <mxGeometry x="300" y="235" width="200" height="90" as="geometry" />
        </mxCell>

        <mxCell id="fe-chatpanel" value="ChatPanel&#10;Personas-Dropdown (dynamisch via GET /api/ask/personas)&#10;Modell-Dropdown (dynamisch via GET /api/ask/models)&#10;Sendet: userPrompt + persona + modelMode + matchData + summoner + puuid" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
