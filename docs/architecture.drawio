          <mxGeometry x="80" y="118" width="200" height="20" as="geometry" />
        </mxCell>

        <mxCell id="fe-router" value="BrowserRouter (main.tsx)&#10;Route / → SearchView&#10;Route /match/:id?gameName&amp;tagLine&amp;puuid → MatchView" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f4ff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
